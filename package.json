{
  "name": "spine",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "web:dev": "corepack pnpm --dir web dev",
    "web:build": "corepack pnpm --dir web build",
    "web:typecheck": "corepack pnpm --dir web typecheck",
    "web:test": "corepack pnpm --dir web test:unit",
    "web:test:e2e": "corepack pnpm --dir web test:e2e",
    "web:check": "corepack pnpm web:typecheck && corepack pnpm web:build && corepack pnpm web:test && corepack pnpm web:test:e2e"
  }
}
