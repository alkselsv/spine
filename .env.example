LLM_API_KEY=
# Optional overrides (Cognee / providers)
# OpenAI-compatible proxies: set *_ENDPOINT (there is no base_url env in Cognee)
# LLM_PROVIDER=openai
# LLM_MODEL=openai/chatgpt-4o-latest
# LLM_ENDPOINT=https://api.vsellm.ru/v1
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_ENDPOINT=https://api.vsellm.ru/v1

# Spine
SPINE_DATASET=spine
SPINE_DATA_DIR=data/incoming

# Development-only local authentication. Keep every value unset unless the
# application composition explicitly selects local auth for a development deployment.
# SPINE_LOCAL_AUTH_DEPLOYMENT_MODE=development
# SPINE_LOCAL_AUTH_CONFIGURATION_VERSION=local-2026-10-11
# SPINE_LOCAL_AUTH_AUTHENTICATION_ALIAS_ISSUER=spine-local://development
# SPINE_LOCAL_AUTH_AUTHENTICATION_ALIAS_SUBJECT=configured-local-administrator
# SPINE_LOCAL_AUTH_BEARER_CREDENTIAL=<random-secret-at-least-32-characters>

# Do NOT set SYSTEM/DATA/CACHE_ROOT_DIRECTORY in this file.
# Cognee does load_dotenv(override=True) on import; relative paths would break
# startup. Spine assigns absolute paths under .spine/ in code.

# PostgreSQL runtime, dispatcher, and migration credentials are deliberately separate.
# SPINE_DATABASE_URL=postgresql+psycopg://runtime_user:secret@host/spine
# SPINE_DISPATCHER_DATABASE_URL=postgresql+psycopg://spine_dispatcher:secret@host/spine
# SPINE_DISPATCHER_DATABASE_DISPATCHER_ROLE=spine_dispatcher
# SPINE_MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:secret@host/spine
# SPINE_MIGRATION_DATABASE_MIGRATION_ROLE=spine_migration
# SPINE_MIGRATION_DATABASE_RUNTIME_ROLE=spine_runtime
# SPINE_MIGRATION_DATABASE_DISPATCHER_ROLE=spine_dispatcher
#
# Operator bootstrap values belong only in a trusted provisioning environment.
# SPINE_OPERATOR_DATABASE_URL=postgresql+psycopg://operator:secret@host/postgres
# SPINE_OPERATOR_DATABASE_DATABASE_NAME=spine
# SPINE_OPERATOR_DATABASE_MIGRATION_ROLE=spine_migration
# SPINE_OPERATOR_DATABASE_MIGRATION_PASSWORD=generated-migration-secret
# SPINE_OPERATOR_DATABASE_RUNTIME_ROLE=spine_runtime
# SPINE_OPERATOR_DATABASE_RUNTIME_PASSWORD=generated-runtime-secret
# SPINE_OPERATOR_DATABASE_DISPATCHER_ROLE=spine_dispatcher
# SPINE_OPERATOR_DATABASE_DISPATCHER_PASSWORD=generated-dispatcher-secret
#
# Dedicated explicit test targets require all three test-only values below.
# Otherwise the mandatory test gate starts postgres:17.6-bookworm via Testcontainers.
# SPINE_TEST_DATABASE_URL=postgresql+psycopg://test_owner:secret@host/spine_test_local
# SPINE_TEST_DATABASE_EXPECTED_NAME=spine_test_local
# SPINE_TEST_DATABASE_DISPOSABLE_MARKER=spine-test-harness:v1:owner_supplied_token

# Disposable local Docker Compose deployment. Copy these names to `.env` and
# generate independent local secrets; never reuse production credentials.
# SPINE_DATABASE_OPERATOR_PASSWORD=<generated-local-secret>
# SPINE_DATABASE_MIGRATION_PASSWORD=<generated-local-secret>
# SPINE_DATABASE_RUNTIME_PASSWORD=<generated-local-secret>
# SPINE_DATABASE_DISPATCHER_PASSWORD=<generated-local-secret>
# SPINE_COGNEE_DATABASE_USERNAME=postgres
# SPINE_COGNEE_DATABASE_PASSWORD=<same-local-postgres-operator-secret>
# SPINE_NEO4J_PASSWORD=<generated-local-secret>
# SPINE_WEB_PORT=4175
# SPINE_API_PORT=18080
# SPINE_POSTGRES_PORT=55432
# SPINE_TEMPORAL_PORT=7233
# SPINE_TEMPORAL_UI_PORT=8233
# SPINE_NEO4J_HTTP_PORT=17474
# SPINE_NEO4J_BOLT_PORT=17687
# SPINE_E2E_IDENTITY_ID=50800000-0000-4000-8000-000000000001
# SPINE_E2E_WORKSPACE_A_ID=50800000-0000-4000-8000-00000000000a
# SPINE_E2E_WORKSPACE_B_ID=50800000-0000-4000-8000-00000000000b
# SPINE_E2E_ENVIRONMENT_A_ID=50800000-0000-4000-8000-00000000000e
# SPINE_E2E_ENVIRONMENT_B_ID=50800000-0000-4000-8000-00000000000f
# SPINE_API_CURSOR_SECRET=<generated-local-secret-at-least-32-characters>
# SPINE_API_INGESTION_SERVICE_PRINCIPAL_ID=50800000-0000-4000-8000-000000000002
# SPINE_PROJECTION_WORKER_SERVICE_PRINCIPAL_ID=50800000-0000-4000-8000-000000000003
# SPINE_QA_WORKER_SERVICE_PRINCIPAL_ID=50800000-0000-4000-8000-000000000004
# SPINE_API_ORIGINAL_STORAGE_ROOT=/var/lib/spine/originals
# SPINE_WORKER_BATCH_SIZE=20
# SPINE_WORKER_POLL_INTERVAL_SECONDS=1
# SPINE_WORKER_LEASE_SECONDS=3600
# SPINE_WORKER_HANDLER_TIMEOUT_SECONDS=3500
# SPINE_WORKER_SHUTDOWN_TIMEOUT_SECONDS=3500
# SPINE_WORKER_RETRY_INITIAL_DELAY_SECONDS=2
# SPINE_WORKER_RETRY_MAXIMUM_DELAY_SECONDS=30
# SPINE_WORKER_TEMPORAL_ADDRESS=temporal:7233
# SPINE_WORKER_TEMPORAL_NAMESPACE=default
# SPINE_WORKER_TEMPORAL_TASK_QUEUE=spine-r1-qa
# Local Q&A API + Temporal worker + authenticated observer capture composition.
# Replace release/commit/profile IDs together and generate distinct credentials.
# SPINE_E2E_API_RELEASE_IDENTITY=issue529-local-dev
# SPINE_QA_DEPLOYMENT_COMMIT_SHA=0000000000000000000000000000000000000000
# SPINE_QA_CAPTURE_WORKER_CREDENTIAL=<independent-random-secret-at-least-32-characters>
# SPINE_QA_CAPTURE_OBSERVER_CREDENTIAL=<different-random-secret-at-least-32-characters>
# SPINE_QA_DEPLOYMENT_SETTINGS_JSON={"schema_version":"spine-production-runtime-settings:v1","profile_id":"spine-local-qa","profile_version":"v1","deployment_fingerprint":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","release_identity":"issue529-local-dev","commit_sha":"0000000000000000000000000000000000000000","database_profile_id":"spine-local-postgresql-v1","migration_revision":"20261119_56","authentication_profile_id":"local-2026-10-11","authentication_mode":"local_development","scope_policy_id":"workspace-environment-v1","temporal_cluster_profile_id":"spine-local-temporal-v1","temporal_namespace":"default","temporal_task_queue":"spine-r1-qa","workflow_contract_version":"spine.qa.ask-admission:v1","capture_service_profile_id":"api-qa-capture-v1","capture_worker_workload_id":"spine-qa-worker","capture_observer_workload_id":"spine-qa-observer","capture_contract_version":"r1-qa-observer-capture:v1","projection_profile_id":"spine-cognee-local-v1","model_profile_id":"openai/chatgpt-4o-latest"}
