# Шаблон настроек времени выполнения одноразового стенда разработки Spine.
# Скопируйте в `.env`, замените все значения `<...>`, установите права 0600 и
# никогда не коммитьте файл, не вставляйте его в задачи и не используйте его
# учётные данные в тестовой или промышленной среде.
#
# Правила загрузки:
# - Docker Compose читает `.env` для подстановки при передаче `--env-file .env`
#   или при стандартном автоматическом поиске `.env`;
# - локальные команды Python и Cognee также могут читать этот файл;
# - для Compose переменные, уже экспортированные в оболочке, могут иметь приоритет;
# - настройки квалификации, браузерных E2E и внешней тестовой БД хранятся в
#   `.env.qualification`, `.env.e2e` и `.env.test`, созданных из соответствующих
#   шаблонов `.example`.
#
# Не задавайте SYSTEM_ROOT_DIRECTORY, DATA_ROOT_DIRECTORY и CACHE_ROOT_DIRECTORY.
# Cognee загружает `.env` с перезаписью значений; Spine назначает абсолютные
# локальные пути до импорта Cognee, чтобы исключить запись за пределами проекта.
# Настройки в формате JSON должны оставаться валидными однострочными документами.

# --- Провайдер моделей и эмбеддингов ---
# LLM_PROVIDER и EMBEDDING_PROVIDER выбирают адаптеры провайдеров Cognee. Имена
# моделей задаются в формате с указанием провайдера, который ожидает адаптер.
# Значения *_API_KEY являются секретами. Для OpenAI-совместимого прокси
# *_ENDPOINT должен указывать на API, обычно с окончанием `/v1`, а не на панель.
# EMBEDDING_DIMENSIONS должен точно соответствовать модели эмбеддингов и текущей
# векторной схеме; изменение требует создания или перестроения проекции.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.4-nano
LLM_API_KEY=<provider-api-key>
LLM_ENDPOINT=https://api.openai.com/v1
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Необязательно: оставьте пустым, если LLM_API_KEY разрешает оба API.
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=https://api.openai.com/v1

# --- Устаревший локальный датасет ---
# Совместимость с исходным прототипом Q&A. SPINE_DATASET — логическое имя
# датасета Cognee, SPINE_DATA_DIR — каталог входящих файлов относительно
# репозитория. Новый ingestion Control Plane использует записи SourceRevision.
SPINE_DATASET=spine
SPINE_DATA_DIR=data/incoming

# --- Одноразовая инфраструктура Compose ---
# Эти учётные данные предназначены только для локального Compose-стенда проекта.
# Создайте независимые стойкие пароли для ролей operator, migration, runtime,
# dispatcher и Neo4j. Пароль БД Cognee намеренно совпадает с паролем оператора
# PostgreSQL: локальная инициализация создаёт БД `cognee` от этой роли. Не
# переносите такое упрощение в промышленную среду.
# SPINE_API_ORIGINAL_STORAGE_ROOT — путь внутри API-контейнера, а не на хосте.
# Порты публикуются на 127.0.0.1; меняйте их только при локальном конфликте и
# оставляйте все порты различными.
SPINE_DATABASE_OPERATOR_PASSWORD=<generated-local-secret>
SPINE_DATABASE_MIGRATION_PASSWORD=<different-generated-local-secret>
SPINE_DATABASE_RUNTIME_PASSWORD=<different-generated-local-secret>
SPINE_DATABASE_DISPATCHER_PASSWORD=<different-generated-local-secret>
SPINE_COGNEE_DATABASE_USERNAME=postgres
SPINE_COGNEE_DATABASE_PASSWORD=<same-value-as-SPINE_DATABASE_OPERATOR_PASSWORD>
SPINE_NEO4J_PASSWORD=<different-generated-local-secret>
SPINE_API_ORIGINAL_STORAGE_ROOT=/var/lib/spine/originals

SPINE_WEB_PORT=4175
SPINE_WEB_FIXTURES_PORT=4176
SPINE_API_PORT=18080
SPINE_POSTGRES_PORT=55432
SPINE_TEMPORAL_PORT=7233
SPINE_TEMPORAL_UI_PORT=8233
SPINE_NEO4J_HTTP_PORT=17474
SPINE_NEO4J_BOLT_PORT=17687

# --- Идентичность разработки и области workspace ---
# Локальная аутентификация разрешена только в явно одноразовом стенде разработки.
# Не открывайте его за пределами доверенной рабочей станции. Учётные данные
# bearer-токена и секрет курсора должны быть независимыми случайными значениями
# длиной от 32 символов.
# CONFIGURATION_VERSION — стабильный несекретный идентификатор поколения;
# меняйте его при каждой замене конфигурации локальной аутентификации.
# Все *_ID — канонические UUID. Администратор и сервисные субъекты для ingestion,
# projection и Q&A должны различаться. Workspace A/B и environment A/B также
# должны различаться для проверки запрета доступа между областями.
# Значения alias issuer/subject должны совпадать с явно подготовленными локальными
# полномочиями квалификации; при запуске API не создаёт идентичности или права.
SPINE_LOCAL_AUTH_AUTHENTICATION_ALIAS_ISSUER=spine-local://development
SPINE_LOCAL_AUTH_AUTHENTICATION_ALIAS_SUBJECT=configured-local-administrator
SPINE_LOCAL_AUTH_BEARER_CREDENTIAL=<random-secret-at-least-32-characters>
SPINE_LOCAL_AUTH_CONFIGURATION_VERSION=local-identity-v1
SPINE_LOCAL_ADMINISTRATOR_ID=50800000-0000-4000-8000-000000000001
SPINE_WORKSPACE_A_ID=50800000-0000-4000-8000-00000000000a
SPINE_WORKSPACE_B_ID=50800000-0000-4000-8000-00000000000b
SPINE_ENVIRONMENT_A_ID=50800000-0000-4000-8000-00000000000e
SPINE_ENVIRONMENT_B_ID=50800000-0000-4000-8000-00000000000f
SPINE_API_CURSOR_SECRET=<different-random-secret-at-least-32-characters>
SPINE_API_INGESTION_SERVICE_PRINCIPAL_ID=50800000-0000-4000-8000-000000000002
SPINE_PROJECTION_WORKER_SERVICE_PRINCIPAL_ID=50800000-0000-4000-8000-000000000003
SPINE_QA_WORKER_SERVICE_PRINCIPAL_ID=50800000-0000-4000-8000-000000000004

# --- Общий профиль развёртывания и канал наблюдения Q&A ---
# API и обработчик Q&A должны описывать одно и то же неизменяемое развёртывание.
# RELEASE_IDENTITY — читаемая версия, COMMIT_SHA — точный текущий Git commit из
# 40 символов, MODEL_PROFILE_ID — идентификатор одобренного профиля развёртывания,
# а не имя модели у провайдера.
# Учётные данные канала наблюдения обработчика и наблюдателя — разные секреты
# длиной от 32 символов;
# их запрещено включать в SPINE_QA_DEPLOYMENT_SETTINGS_JSON.
# JSON использует схему `spine-production-runtime-settings:v1`. Храните его в
# одной строке, синхронизируйте поля release/commit/model/Temporal/auth с соседними
# переменными и меняйте 64-символьный отпечаток развёртывания при любом изменении
# связанной конфигурации времени выполнения.
SPINE_RUNTIME_RELEASE_IDENTITY=spine-local-r1
SPINE_QA_DEPLOYMENT_COMMIT_SHA=<current-40-character-git-commit>
SPINE_QA_MODEL_PROFILE_ID=spine-openai-r1-v1
SPINE_QA_CAPTURE_WORKER_CREDENTIAL=<independent-random-secret-at-least-32-characters>
SPINE_QA_CAPTURE_OBSERVER_CREDENTIAL=<different-random-secret-at-least-32-characters>
SPINE_QA_DEPLOYMENT_SETTINGS_JSON={"authentication_mode":"local_development","authentication_profile_id":"local-identity-v1","capture_contract_version":"r1-qa-observer-capture:v1","capture_observer_workload_id":"spine-qa-observer","capture_service_profile_id":"api-qa-capture-v1","capture_worker_workload_id":"spine-qa-worker","commit_sha":"<current-40-character-git-commit>","database_profile_id":"spine-local-postgresql-v1","deployment_fingerprint":"<deployment-fingerprint>","migration_revision":"20261122_59","model_profile_id":"spine-openai-r1-v1","profile_id":"spine-local-qa","profile_version":"v1","projection_profile_id":"spine-cognee-local-v1","release_identity":"spine-local-r1","schema_version":"spine-production-runtime-settings:v1","scope_policy_id":"workspace-environment-v1","temporal_cluster_profile_id":"spine-local-temporal-v1","temporal_namespace":"default","temporal_task_queue":"spine-r1-qa","workflow_contract_version":"spine.qa.ask-admission:v1"}

# --- Привязка провайдера проекций ---
# Строгий несекретный JSON `cognee-projection-binding:v1`, который читает
# диспетчер outbox. Он связывает одобренный CogneeWorkerProfile, независимое
# разрешение,
# наблюдаемый RuntimeIdentity, deployment ID и release ID.
# Создавайте profile_digest через CogneeWorkerProfile.digest_for. Не помещайте в
# JSON ключи API, пароли БД, секретные значения или разрешение на платный запуск;
# авторизация провайдера должна находиться в `.env.qualification`.
SPINE_COGNEE_WORKER_BINDING_JSON=<approved-cognee-projection-binding-v1-json>

# --- Обработчик outbox ---
# Положительные целые лимиты обработки для диспетчера projection outbox.
# Таймаут обработчика должен быть строго меньше аренды, а таймаут остановки не
# должен превышать аренду. Начальная задержка повтора не должна превышать
# максимальную.
# Адрес, пространство имён и очередь задач Temporal должны совпадать с сервисом
# Temporal и соответствующим неизменяемым профилем Q&A.
SPINE_WORKER_BATCH_SIZE=20
SPINE_WORKER_POLL_INTERVAL_SECONDS=1
SPINE_WORKER_LEASE_SECONDS=3600
SPINE_WORKER_HANDLER_TIMEOUT_SECONDS=3500
SPINE_WORKER_SHUTDOWN_TIMEOUT_SECONDS=3500
SPINE_WORKER_RETRY_INITIAL_DELAY_SECONDS=2
SPINE_WORKER_RETRY_MAXIMUM_DELAY_SECONDS=30
SPINE_WORKER_TEMPORAL_ADDRESS=temporal:7233
SPINE_WORKER_TEMPORAL_NAMESPACE=default
SPINE_WORKER_TEMPORAL_TASK_QUEUE=spine-r1-qa

# --- Настройки PostgreSQL вне Compose, только для справки ---
# Используйте их только при запуске процессов вне compose.yaml. URL для runtime,
# dispatcher, migration и operator должны использовать разные роли с минимальными
# привилегиями. Не раскомментируйте их для обычного Compose-запуска: Compose сам
# строит URL внутри контейнерной сети из паролей SPINE_DATABASE_* выше.
# SPINE_DATABASE_URL=postgresql+psycopg://runtime_user:secret@host/spine
# SPINE_DISPATCHER_DATABASE_URL=postgresql+psycopg://dispatcher_user:secret@host/spine
# SPINE_MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:secret@host/spine
# SPINE_OPERATOR_DATABASE_URL=postgresql+psycopg://operator:secret@host/postgres
