        "type": "object"
      },
      "PublicAcceptanceStatus": {
        "enum": [
          "pending",
          "accepted",
          "rejected",
          "quarantined"
        ],
        "title": "PublicAcceptanceStatus",
        "type": "string"
      },
      "PublicBatchStatus": {
        "enum": [
          "processing",
          "succeeded",
          "partial",
          "failed",
          "cancelled"
        ],
        "title": "PublicBatchStatus",
        "type": "string"
      },
      "PublicIngestionStatus": {
        "enum": [
          "non_terminal",
          "succeeded",
          "partial",
          "failed",
          "rejected",
          "quarantined",
          "unsupported",
          "cancelled"
        ],
        "title": "PublicIngestionStatus",
        "type": "string"
      },
      "PublicProcessingStatus": {
        "enum": [
          "not_started",
          "processing",
          "succeeded",
          "partial",
          "failed",
          "unsupported",
          "cancelled"
        ],
        "title": "PublicProcessingStatus",
        "type": "string"
      },
