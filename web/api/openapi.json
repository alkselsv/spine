  "info": {
    "description": "Phase 1: company Q&A on Cognee. Trace-like orchestration comes later.",
    "title": "Spine",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/documents/batches": {
      "post": {
        "operationId": "ingestion.batch_upload",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Workspace-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Environment-ID",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "additionalProperties": {
                  "format": "binary",
                  "type": "string"
                },
                "description": "Each property name is the stable input identity. TXT and Markdown are the completed batch formats.",
                "maxProperties": 20,
                "minProperties": 1,
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchIngestionUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Ingestion.Batch Upload"
      }
    },
