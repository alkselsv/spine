            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "IngestRequest",
        "type": "object"
      },
      "IngestResponse": {
        "properties": {
          "documents": {
            "title": "Documents",
            "type": "integer"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "path",
          "documents",
          "status"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "IngestionReceiptResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_digest": {
            "anyOf": [
              {
                "pattern": "[0-9a-f]{64}",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Digest"
          },
          "artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Id"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "failed"
            ],
            "title": "Coverage",
            "type": "string"
          },
          "parser_name": {
            "title": "Parser Name",
            "type": "string"
          },
          "receipt_id": {
            "format": "uuid",
            "title": "Receipt Id",
            "type": "string"
          }
