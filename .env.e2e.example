# Шаблон входных данных браузерной квалификации промышленного профиля и отчётов.
# Скопируйте его в `.env.e2e`, замените все значения `<...>` и никогда не
# коммитьте получившийся файл. Playwright сначала загружает `.env`, а затем
# накладывает этот файл. Runtime-учётные данные и области workspace/environment
# поэтому должны иметь единственный источник в `.env`.

# --- Целевой стенд и одобренные входные данные ---
SPINE_E2E_WEB_BASE_URL=http://127.0.0.1:4175
SPINE_E2E_DOCUMENT_PATH=<absolute-path-to-approved-synthetic-document>
# SPINE_E2E_DOCX_DOCUMENT_PATH=<absolute-path-to-approved-synthetic-docx>
# SPINE_E2E_INPUT_ROOT=<absolute-path-to-approved-five-format-input-directory>

# --- Вопросы ---
SPINE_E2E_ANSWERABLE_QUESTION=<approved-question>
SPINE_E2E_UNANSWERABLE_QUESTION=<approved-question>
SPINE_E2E_CANCEL_QUESTION=<approved-question>

# --- Метаданные квалификации ---
SPINE_E2E_QUALIFICATION_RUN_ID=<run-id>
# SPINE_E2E_INGESTION_RUN_ID=<ingestion-run-id>
SPINE_E2E_COMMIT_SHA=<current-40-character-git-commit>
SPINE_E2E_DEPLOYMENT_FINGERPRINT=<deployment-fingerprint>
SPINE_E2E_WEB_RELEASE_IDENTITY=<web-release-id>
SPINE_E2E_PROVIDER_PROFILE_IDENTITY=<provider-profile-id>
# SPINE_E2E_AUTHORIZATION_GENERATION=1
# SPINE_E2E_TRUSTED_UPLOAD_AUTHORITY_REFERENCE=<safe-reference>
# SPINE_INGESTION_QUALIFICATION_CORPUS_DIR=<approved-five-format-corpus-directory>
# SPINE_INGESTION_QUALIFICATION_CORPUS_APPROVAL_REFERENCE=<safe-approval-reference>

# --- Выходные файлы доказательств ---
SPINE_E2E_REPORT_PATH=../docs/qualification/local-governed-qa-browser-report.json
# SPINE_INGESTION_QUALIFICATION_REPORT_PATH=../docs/qualification/local-five-format-ingestion-report.json
# SPINE_INGESTION_Q16_REPORT_PATH=../docs/qualification/local-ingestion-q16-report.json
