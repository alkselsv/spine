# Шаблон одноразовых полномочий квалификации и авторизации провайдера.
# Скопируйте его в `.env.qualification`, замените все значения `<...>` и никогда
# не коммитьте получившийся файл. Передавайте вместе с runtime-настройками:
# docker compose --env-file .env --env-file .env.qualification ...
# Для обычного локального запуска предпочтительнее безопасная генерация:
# make qualification-env
# Существующий файл не перезаписывается без явного `FORCE=1`.

# --- Полномочия квалификации ---
# Укажите осознанно выбранный будущий жёсткий срок в UTC. Запуск и проверка
# готовности никогда не создают полномочия автоматически.
SPINE_QUALIFICATION_AUTHORITY_EXPIRES_AT=<future-UTC-hard-expiry>
SPINE_QUALIFICATION_TARGET_REFERENCE=deployment:source:<deployment-fingerprint>
SPINE_QUALIFICATION_TARGET_SCOPE_REFERENCE=scope:workspace-environment:v1
SPINE_QUALIFICATION_SECRET_PROVIDER_REFERENCE=provider:local-env:v1
SPINE_QUALIFICATION_SECRET_REFERENCE=secret:qualification-source:v1
SPINE_QUALIFICATION_DATABASE_ROLE_REFERENCE=postgres-role:spine-runtime:v1

# --- Авторизация провайдера ---
# Строгий JSON только для разработки, ограниченный областью доступа и бюджетом.
# Digest профиля должен совпадать со SPINE_COGNEE_WORKER_BINDING_JSON из `.env`,
# а срок действия авторизации не должен быть истёкшим.
SPINE_COGNEE_LOCAL_PROVIDER_AUTHORIZATION_JSON=<development-only-scope-and-budget-authorization-json>

# --- Необязательные доказательства квалификации Cognee ---
SPINE_COGNEE_QUALIFICATION_RUN_ID=<qualification-run-id>
SPINE_COGNEE_QUALIFICATION_REPORT=<metadata-only-report-path>

# --- Необязательная инъекция сбоев только для квалификации ---
# При обычном локальном использовании оставляйте значения пустыми.
SPINE_INGESTION_FAULT_PROFILE_JSON=
SPINE_PROJECTION_PUBLICATION_FAULT_PROFILE_JSON=

# --- Google My Drive + Sheets Phase 1 qualification ---
# Keep this file mode 0600 and outside Git. Exact provider IDs and OAuth values
# are private. SPINE_GOOGLE_LIVE_OPT_IN is deliberately not persisted here.
GOOGLE_QUALIFICATION_ACCOUNT=<isolated-google-account>
GOOGLE_CLOUD_PROJECT_ID=<isolated-google-cloud-project-id>
GOOGLE_OAUTH_CLIENT_FILE=<private-web-oauth-client-path>
GOOGLE_ROOT_FOLDER_ID=<root-folder-id>
GOOGLE_NESTED_FOLDER_IDS=<comma-separated-nested-folder-ids>
GOOGLE_ALLOWED_FILE_IDS=<pdf-id,docx-id,native-google-doc-id>
GOOGLE_SPREADSHEET_IDS=<spreadsheet-id>
GOOGLE_NUMERIC_SHEET_IDS=<first-sheet-gid,second-sheet-gid>
GOOGLE_SHARED_DRIVE_STATUS=NOT_EXERCISED
GOOGLE_RESOURCE_SCOPE_VERSION=google-615-phase1-scope:v1
GOOGLE_PDF_FILE_ID=<pdf-file-id>
GOOGLE_DOCX_FILE_ID=<docx-file-id>
GOOGLE_NATIVE_DOC_FILE_ID=<native-google-doc-file-id>

# Exact immutable authority from the PostgreSQL-canonical Google connection.
# These values are references/IDs, never OAuth material. Use NONE only for a
# version-1 connection that has no predecessor.
SPINE_GOOGLE_CONNECTION_VERSION_ID=<canonical-connection-version-uuid>
SPINE_GOOGLE_CONNECTION_ID=<canonical-connection-uuid>
SPINE_GOOGLE_APPROVAL_ID=<canonical-approval-uuid>
SPINE_GOOGLE_CONNECTION_VERSION=<positive-version>
SPINE_GOOGLE_PREDECESSOR_VERSION_ID=<predecessor-version-uuid-or-NONE>
SPINE_GOOGLE_WORKSPACE_ID=<canonical-workspace-uuid>
SPINE_GOOGLE_ENVIRONMENT_ID=<canonical-environment-uuid>
SPINE_GOOGLE_SERVICE_PRINCIPAL_ID=<canonical-service-principal-uuid>
SPINE_GOOGLE_CREDENTIAL_REFERENCE=<canonical-credential-reference-uuid>
SPINE_GOOGLE_GRANT_REFERENCE=<canonical-grant-reference-uuid>
SPINE_GOOGLE_RESOURCE_SCOPE_REFERENCE=<canonical-resource-scope-reference-uuid>
SPINE_GOOGLE_AUTHORIZATION_GENERATION=<positive-generation>
SPINE_GOOGLE_CONFIGURATION_GENERATION=<positive-generation>

SPINE_GOOGLE_QUALIFICATION_MANIFEST_SHA256=<approved-direct-values-sha256>
SPINE_GOOGLE_LIVE_CONFIG_OPT_IN=
SPINE_GOOGLE_LIVE_APPROVED_EFFECTIVE_FINGERPRINT=
SPINE_GOOGLE_OAUTH_REDIRECT_URI=<exact-registered-localhost-callback>
SPINE_GOOGLE_OAUTH_CLIENT_ID=<web-oauth-client-id>
SPINE_GOOGLE_OAUTH_CLIENT_SECRET=<web-oauth-client-secret>
SPINE_GOOGLE_OAUTH_REFRESH_TOKEN=
SPINE_GOOGLE_LIVE_REPORT=<private-sanitized-report-path>
