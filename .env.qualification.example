# Шаблон одноразовых полномочий квалификации и авторизации провайдера.
# Скопируйте его в `.env.qualification`, замените все значения `<...>` и никогда
# не коммитьте получившийся файл. Передавайте вместе с runtime-настройками:
# docker compose --env-file .env --env-file .env.qualification ...
# Для обычного локального запуска предпочтительнее безопасная генерация:
# make qualification-env
# Существующий файл не перезаписывается без явного `FORCE=1`.

# --- Полномочия квалификации ---
# Укажите осознанно выбранный будущий жёсткий срок в UTC. Запуск и проверка
# готовности никогда не создают полномочия автоматически.
SPINE_QUALIFICATION_AUTHORITY_EXPIRES_AT=<future-UTC-hard-expiry>
SPINE_QUALIFICATION_TARGET_REFERENCE=deployment:source:<deployment-fingerprint>
SPINE_QUALIFICATION_TARGET_SCOPE_REFERENCE=scope:workspace-environment:v1
SPINE_QUALIFICATION_SECRET_PROVIDER_REFERENCE=provider:local-env:v1
SPINE_QUALIFICATION_SECRET_REFERENCE=secret:qualification-source:v1
SPINE_QUALIFICATION_DATABASE_ROLE_REFERENCE=postgres-role:spine-runtime:v1

# --- Авторизация провайдера ---
# Строгий JSON только для разработки, ограниченный областью доступа и бюджетом.
# Digest профиля должен совпадать со SPINE_COGNEE_WORKER_BINDING_JSON из `.env`,
# а срок действия авторизации не должен быть истёкшим.
SPINE_COGNEE_LOCAL_PROVIDER_AUTHORIZATION_JSON=<development-only-scope-and-budget-authorization-json>

# --- Необязательные доказательства квалификации Cognee ---
SPINE_COGNEE_QUALIFICATION_RUN_ID=<qualification-run-id>
SPINE_COGNEE_QUALIFICATION_REPORT=<metadata-only-report-path>

# --- Необязательная инъекция сбоев только для квалификации ---
# При обычном локальном использовании оставляйте значения пустыми.
SPINE_INGESTION_FAULT_PROFILE_JSON=
SPINE_PROJECTION_PUBLICATION_FAULT_PROFILE_JSON=
