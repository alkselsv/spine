# Шаблон необязательной внешней тестовой базы данных.
# Копируйте в `.env.test` только при осознанном использовании одноразового
# PostgreSQL-стенда, предоставленного владельцем. Оставьте все значения
# незаданными, чтобы использовать стандартный сценарий с Testcontainers.

SPINE_TEST_DATABASE_URL=postgresql+psycopg://test_owner:<secret>@host/spine_test_local
SPINE_TEST_DATABASE_EXPECTED_NAME=spine_test_local
SPINE_TEST_DATABASE_DISPOSABLE_MARKER=spine-test-harness:v1:<owner-supplied-token>
